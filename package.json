{
  "name": "nodra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.15.1 <11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm --filter @nodra/web build",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:all": "pnpm test && pnpm test:e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@playwright/test": "1.55.0",
    "@types/node": "24.2.1",
    "eslint": "9.33.0",
    "globals": "16.3.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.0",
    "vitest": "3.2.4",
    "@vitejs/plugin-react": "5.0.2",
    "vite": "7.1.3",
    "vite-plugin-pwa": "1.0.2"
  }
}
